#!/usr/bin/env sh
set -eu

SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)

if [ -x "$SCRIPT_DIR/target/release/agent-skill-validate" ]; then
  exec "$SCRIPT_DIR/target/release/agent-skill-validate" "$@"
fi

if [ -x "$SCRIPT_DIR/target/debug/agent-skill-validate" ]; then
  exec "$SCRIPT_DIR/target/debug/agent-skill-validate" "$@"
fi

if command -v cargo >/dev/null 2>&1 && [ -f "$SCRIPT_DIR/Cargo.toml" ]; then
  exec cargo run --quiet --manifest-path "$SCRIPT_DIR/Cargo.toml" --bin agent-skill-validate -- "$@"
fi

echo "agent-skill-validate: build the Rust binary first: cargo build --release --bin agent-skill-validate" >&2
exit 127
